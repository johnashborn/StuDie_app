<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ui.ReviewFlashcards">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card 1 of 10"
                android:textSize="14sp"
                android:textColor="#666666"
                android:textStyle="bold"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0/0"
                android:textSize="14sp"
                android:textColor="#6200EE"
                android:textStyle="bold"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:progressTint="#6200EE"
            android:progressBackgroundTint="#E0E0E0"
            android:progress="10"
            android:max="100"/>

    </LinearLayout>

    <!-- Main Flashcard Container -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toTopOf="@id/actionButtonsSection"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Question Card (Front) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_card_background"
                android:padding="24dp">

                <!-- "Question" Label -->
                <TextView
                    android:id="@+id/questionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUESTION"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:alpha="0.8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"/>

                <!-- Question Text -->
                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="What is the capital of France?"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    tools:text="What is the capital of France?"/>

                <!-- Tap to Reveal Hint -->
                <LinearLayout
                    android:id="@+id/tapHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:alpha="0.9"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to reveal answer"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="8dp"
                        android:textStyle="italic"/>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Answer Card (Back) - Initially Hidden -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/answerCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="2dp"
            app:strokeColor="#03DAC5"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:padding="24dp">

                <!-- "Answer" Label -->
                <TextView
                    android:id="@+id/answerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANSWER"
                    android:textSize="12sp"
                    android:textColor="#03DAC5"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"/>

                <!-- Question (Small) -->
                <TextView
                    android:id="@+id/questionTextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="What is the capital of France?"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/answerLabel"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    tools:text="What is the capital of France?"/>

                <!-- Divider -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:background="#03DAC5"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/questionTextSmall"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>

                <!-- Answer Text -->
                <TextView
                    android:id="@+id/answerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Paris"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    tools:text="Paris"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Action Buttons Section -->
    <LinearLayout
        android:id="@+id/actionButtonsSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Instruction Text -->
        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How well did you know this?"
            android:textSize="16sp"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <!-- Button Row -->
        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <!-- Wrong Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/wrongButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Wrong"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconPadding="4dp"
                app:cornerRadius="12dp"
                app:backgroundTint="#F44336"
                android:layout_marginEnd="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <!--repeat-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/repeatButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Repeat"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_menu_rotate"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconPadding="4dp"
                app:cornerRadius="12dp"
                app:backgroundTint="#FF9800"
                android:layout_marginEnd="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <!-- Right Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Correct"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textStyle="bold"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconPadding="4dp"
                app:cornerRadius="12dp"
                app:backgroundTint="#4CAF50"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
